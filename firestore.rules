rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// A Fish in the Kitchen — household-private, subscription-gated access model.
// Mirrors src/lib/access.ts. See the project_subscription_model spec.
//
// LIVE — deployed 2026-05-30. These rules require (and the app maintains) the
// following invariants; breaking one locks users out:
//   1. Every household doc has `memberIds` (array of member uids) and
//      `accessState`. createHousehold sets these; /api/join keeps memberIds in
//      sync. Legacy docs were backfilled via scripts/backfill-households.mjs.
//   2. The invite-accept / join step runs SERVER-SIDE via the Admin SDK (which
//      bypasses these rules), because joining adds a uid to the owner's
//      household doc — which members aren't allowed to write here.
//   3. Subscription writes happen server-side (webhooks via Admin SDK).
// Re-test in the Rules Playground / emulator before changing.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    // True for verified email/password users and all Google/Apple sign-ins.
    // Unverified self-serve users can read/set up but not write content/invite.
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isSuperAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/config/superAdmins)
        && email() in get(/databases/$(database)/documents/config/superAdmins).data.emails;
    }

    // Read a household doc's data (used for membership / owner / state checks).
    function hh(hid) {
      return get(/databases/$(database)/documents/households/$(hid)).data;
    }
    function householdExists(hid) {
      return exists(/databases/$(database)/documents/households/$(hid));
    }

    function isMember(hid) {
      return isSignedIn() && householdExists(hid) && request.auth.uid in hh(hid).memberIds;
    }
    function isOwner(hid) {
      return isSignedIn() && householdExists(hid) && request.auth.uid == hh(hid).ownerId;
    }
    function stateOf(hid) {
      // Legacy docs without accessState are treated as active.
      return ("accessState" in hh(hid)) ? hh(hid).accessState : "active";
    }

    // Members may read their household's data unless it's suspended.
    function canRead(hid) {
      return isSuperAdmin() || (isMember(hid) && stateOf(hid) != "suspended");
    }
    // Members may write only while the household is fully active (not read-only /
    // suspended) AND their email is verified.
    function canWrite(hid) {
      return isSuperAdmin() || (isMember(hid) && stateOf(hid) == "active" && isEmailVerified());
    }

    // ── Households ──
    match /households/{hid} {
      // uids this update would add to / remove from memberIds.
      function addedMemberIds() {
        return request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet());
      }
      function removedMemberIds() {
        return resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet());
      }

      allow read: if isSuperAdmin()
        || (isSignedIn() && request.auth.uid in resource.data.memberIds
            && resource.data.accessState != "suspended");
      // Creation is server-side only (/api/create-household via Admin SDK): it is
      // the enforcement point for one-owned-book-per-user and slug uniqueness,
      // and it writes the owner's householdMembers doc, which clients can't.
      allow create: if isSuperAdmin();
      // The owner may edit branding/settings fields ONLY. accessState, plan,
      // ownerId, deleteAfter etc. are server-owned — an unrestricted owner
      // update would let a lapsed owner re-activate themselves.
      // memberIds may SHRINK client-side (owner removes a member; a member
      // removes exactly themselves to leave) but never grow: additions happen
      // in /api/join, which is where the seat cap is enforced.
      allow update: if isSuperAdmin()
        || (isSignedIn() && request.auth.uid == resource.data.ownerId
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['name', 'customisation', 'seatUpgradeRequestedAt']))
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && addedMemberIds().size() == 0
            && resource.data.ownerId in request.resource.data.memberIds
            && (request.auth.uid == resource.data.ownerId
                || removedMemberIds().hasOnly([request.auth.uid])))
        // Any member may pin the week's Recipe of the Week (a display cache —
        // first device of the week computes it, everyone else reads it).
        || (isSignedIn() && request.auth.uid in resource.data.memberIds
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recipeOfWeek']));
      allow delete: if isSuperAdmin();
    }

    // ── Household members (the join table) ──
    match /householdMembers/{id} {
      allow read: if isSuperAdmin()
        || (isSignedIn()
            && (resource.data.userId == request.auth.uid || isMember(resource.data.householdId)));
      // Creating memberships (owner + invite-accept) is server-side only.
      allow create: if isSuperAdmin();
      // Owner can remove members; a member can remove themselves (leave).
      allow delete: if isSuperAdmin()
        || isOwner(resource.data.householdId)
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isSuperAdmin();
    }

    // ── Subscriptions (one per user) ──
    match /subscriptions/{userId} {
      allow read: if isSuperAdmin() || (isSignedIn() && request.auth.uid == userId);
      // All writes via Admin SDK (checkout / webhooks). Clients never write directly.
      allow write: if isSuperAdmin();
    }

    // ── Recipes — household-private ──
    match /recipes/{id} {
      allow read: if canRead(resource.data.householdId);
      allow create: if canWrite(request.resource.data.householdId);
      allow update, delete: if canWrite(resource.data.householdId);
    }

    // ── Family member profiles ──
    match /members/{id} {
      allow read: if canRead(resource.data.householdId);
      allow create: if canWrite(request.resource.data.householdId);
      allow update, delete: if canWrite(resource.data.householdId);
    }

    // ── Shared-recipe snapshots + shared-menu tokens (server-only; via API/SSR) ──
    match /sharedRecipes/{token} {
      allow read, write: if false;
    }
    match /sharedMenus/{token} {
      allow read, write: if false;
    }

    // ── Meal plans (per user, within a household) ──
    match /mealPlans/{id} {
      // A meal-plan doc is created lazily on first save, so a fresh week has no
      // doc yet. Firestore sets `resource` to null for a non-existent doc, which
      // makes a bare canRead() deny the read — surfacing as a spurious "couldn't
      // load" error. Allow any signed-in user to read a missing doc (reveals
      // nothing); gate existing docs on household membership as before.
      allow read: if isSignedIn() && (resource == null || canRead(resource.data.householdId));
      allow create: if canWrite(request.resource.data.householdId)
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if canWrite(resource.data.householdId)
        && resource.data.userId == request.auth.uid;
    }

    // ── Shopping lists (per user, synced across their devices — and, when the
    // owner says so, standing-shared with other members of the household) ──
    // Doc id = {uid}_{householdId}. Created lazily on first save, so allow signed-in
    // reads of a missing doc (reveals nothing); gate existing docs on ownership
    // OR on being named in the owner's `sharedWith`.
    match /shoppingLists/{id} {
      // The uids the OWNER has standing-shared this list with. get() with a
      // default because docs written before sharing existed have no field.
      function isSharedReader() {
        return request.auth.uid in resource.data.get('sharedWith', []);
      }
      allow read: if isSignedIn()
        && (resource == null
            || ((resource.data.userId == request.auth.uid || isSharedReader())
                && canRead(resource.data.householdId)));
      allow create: if request.resource.data.userId == request.auth.uid
        && canWrite(request.resource.data.householdId);
      // A shared member may edit the CONTENT — entries, ticks, typed items —
      // but never the ownership: userId and householdId are frozen for
      // everyone, and only the OWNER may change sharedWith. Being shared with
      // someone must not let them share the list onward or take it over.
      allow update: if (resource.data.userId == request.auth.uid || isSharedReader())
        && canWrite(resource.data.householdId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.householdId == resource.data.householdId
        && (resource.data.userId == request.auth.uid
            || request.resource.data.get('sharedWith', []) == resource.data.get('sharedWith', []));
      allow delete: if resource.data.userId == request.auth.uid
        && canWrite(resource.data.householdId);
    }

    // ── Event menus / collections ──
    match /collections/{id} {
      allow read: if canRead(resource.data.householdId);
      allow create: if canWrite(request.resource.data.householdId);
      allow update, delete: if canWrite(resource.data.householdId);
    }

    // ── Tips & tricks ──
    match /tips/{id} {
      allow read: if canRead(resource.data.householdId);
      allow create: if canWrite(request.resource.data.householdId);
      allow update, delete: if canWrite(resource.data.householdId);
    }

    // ── Learn (global content from A Fish in the Kitchen — docs/LEARN.md) ──
    // NOT household-scoped: every signed-in user reads the same published
    // library. Authoring happens only via /api/admin/learn (Admin SDK, which
    // bypasses these rules), so no client may ever write here.
    // ⚠ App queries must filter status == "published" and sort CLIENT-SIDE —
    // an orderBy on top of the filter needs a composite index nobody declared.
    match /learnItems/{id} {
      allow read: if isSignedIn() && resource.data.status == "published";
      allow write: if false;
    }

    // ── Notifications ──
    match /notifications/{id} {
      allow read: if canRead(resource.data.householdId);
      allow create: if canWrite(request.resource.data.householdId);
      // Mark-as-read only: a reader may append themselves to readBy, but may not
      // rewrite the notification's content (message/link/author/etc.).
      allow update: if canRead(resource.data.householdId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
      allow delete: if canWrite(resource.data.householdId);
    }

    // ── Invited users (doc id = invitee email, lowercased) ──
    match /invitedUsers/{inviteEmail} {
      // The invitee can read their own invite; the inviting household's owner can manage.
      allow read: if isSignedIn()
        && (inviteEmail == email()
            || isSuperAdmin()
            || (resource != null && isOwner(resource.data.householdId)));
      // Creating/updating invites is SERVER-SIDE ONLY (Admin SDK via /api/invite,
      // which bypasses these rules). That route is the authoritative enforcement
      // point for owner-auth, the duplicate guard, and the seat cap — clients
      // must not write invites directly. /api/join marks invites registered.
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin() || isOwner(resource.data.householdId);
    }

    // ── Gift codes ──
    match /gifts/{code} {
      // ⚠ NO CLIENT READS AT ALL, and that is the whole point. The doc id IS
      // the gift code, and the code is a BEARER TOKEN — anybody holding a valid
      // one can claim a year. A rule permitting signed-in reads would let any
      // account enumerate or confirm codes; there is no version of "read a gift
      // you don't hold" that is safe.
      //
      // The recipient never needs a read: /g/{code} renders server-side, and
      // /api/gift/redeem does the lookup with the Admin SDK, which bypasses
      // these rules entirely. The buyer sees their code in the purchase
      // response.
      //
      // Writes are server-only for the same reason writes to invitedUsers are:
      // the API route is the authoritative enforcement point for the verified
      // store receipt, the one-redemption-only transaction, and the refusal
      // rules in lib/gift.ts. A client that could write here could mint itself
      // a free year.
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ── User preferences (private to the user) ──
    match /userPreferences/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ── Global config ──
    match /config/{docId} {
      // superAdmins holds platform-staff emails — only superadmins may read it
      // (both clients treat a denied read as "not a superadmin"). Other config
      // docs stay readable to signed-in users for UI gating.
      allow read: if docId == "superAdmins" ? isSuperAdmin() : isSignedIn();
      allow write: if isSuperAdmin();
    }
  }
}
